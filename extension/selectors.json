{
  "_comment": "DOM selectors for chatgpt.com / claude.ai / gemini.google.com / grok.com. These break often when vendors redesign. Edit this file; do not hard-code in content.js. \"assistantMessage\" = selectors that match a previous assistant answer; when none match (new/empty chat, or an unknown layout) the extension adds only the style note, never the \"redo the last answer\" request.",
  "chatgpt.com": {
    "input": "#prompt-textarea, textarea[data-id], div[contenteditable='true']#prompt-textarea, form textarea",
    "messages": "[data-message-author-role], .agent-turn, main article",
    "assistantMessage": [
      "[data-message-author-role='assistant']"
    ],
    "userRoleAttr": "data-message-author-role",
    "userRoleValue": "user",
    "assistantRoleValue": "assistant"
  },
  "claude.ai": {
    "input": "div[contenteditable='true'].ProseMirror, fieldset textarea, div[contenteditable='true']",
    "messages": "[data-test-render-count], .font-claude-message, div[data-is-streaming]",
    "assistantMessage": [
      "div[data-is-streaming]",
      ".font-claude-response",
      ".font-claude-message"
    ],
    "userRoleAttr": null,
    "userHint": "human|user",
    "assistantHint": "assistant|claude"
  },
  "gemini.google.com": {
    "input": "rich-textarea textarea, .ql-editor, div[contenteditable='true']",
    "messages": "message-content, .model-response-text, .user-query-bubble-with-background",
    "assistantMessage": [
      "model-response",
      "message-content.model-response-text",
      ".model-response-text"
    ],
    "userRoleAttr": null,
    "userHint": "user-query",
    "assistantHint": "model-response"
  },
  "grok.com": {
    "_verified": "2026-10-07: logged-out composer = textarea[aria-label='Ask Grok anything'] in a form. Logged-in layout not verified, so several candidates are tried in order; the first visible, editable match wins. If none match, the extension copies the note to the clipboard and shows a 'couldn't find the chat box' chip.",
    "input": [
      "textarea[aria-label='Ask Grok anything']",
      "textarea[aria-label*='Grok' i]",
      "textarea[placeholder*='Grok' i]",
      "textarea[aria-label*='Ask' i]",
      "div[contenteditable='true'][aria-label*='Grok' i]",
      "div.tiptap.ProseMirror[contenteditable='true']",
      "div.ProseMirror[contenteditable='true']",
      "[role='textbox'][contenteditable='true']",
      "form textarea",
      "main textarea",
      "div[contenteditable='true']"
    ],
    "submit": [
      "form button[type='submit']",
      "button[aria-label='Submit']",
      "button[aria-label*='Send' i]",
      "button[aria-label*='Submit' i]",
      "button[aria-label*='보내기']"
    ],
    "messages": "[class*='message-bubble'], [data-testid*='message'], main article",
    "assistantMessage": [
      "[data-testid='assistant-message']",
      "div.items-start [class*='message-bubble']",
      "[class*='response-content-markdown']"
    ],
    "userRoleAttr": null,
    "userHint": "items-end|user",
    "assistantHint": "items-start|assistant|grok",
    "_verifiedAssistant": "2026-10-07: assistantMessage candidates for grok.com are not verified on a logged-in chat; if none match, a pick on an empty box adds only the style note (no rewrite request)."
  }
}
